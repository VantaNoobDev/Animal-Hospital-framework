{
  "name": "genrojotree",
  "version": "1.0.0",
  "private": true,
  "description": "Tooling for ObjectAbuse (Rojo tree generation, lint, build)",
  "scripts": {
    "lint": "selene src",
    "build:rojo": "node tools/genRojoTree.js",
    "build:place": "rojo build default.project.json -o ObjectAbuse.rbxlx",
    "build:sourcemap": "rojo sourcemap default.project.json -o sourcemap.json",
    "check": "npm run build:rojo && npm run lint && npm run build:place && npm run build:sourcemap",
    "test": "npm run check",
    "watch:rojo": "chokidar \"src/**/*\" -c \"npm run build:rojo\""
  },
  "keywords": [],
  "license": "ISC",
  "devDependencies": {
    "chokidar-cli": "^3.0.0"
  }
}
